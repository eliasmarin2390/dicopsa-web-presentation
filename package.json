{
  "name": "dicopsa-web-presentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Presentación web interactiva sobre el análisis estratégico y tecnológico de DICOPSA.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "reveal.js": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
